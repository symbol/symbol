---
Language: Cpp
BasedOnStyle: LLVM

# Line limits
ColumnLimit: 140

# Indentation — tabs, 4-wide, everywhere including continuation
IndentWidth: 4
TabWidth: 4
UseTab: Always
ContinuationIndentWidth: 8

# Access modifiers sit at class level (not indented into body)
# Class body = class_indent + IndentWidth; public:/private: = class_indent + 0
AccessModifierOffset: -4

# Namespace indentation: "All" handles both project styles correctly:
#   1. Forward-declaration block:  namespace catapult { namespace cache { ... } }
#      — each level indented, so "namespace cache {" at +1 tab, content at +2 tabs
#   2. Code block: compact "namespace catapult { namespace cache {" with 1-level indent
#      — CompactNamespaces collapses the two into one level, content at +1 tab
NamespaceIndentation: All
CompactNamespaces: true
FixNamespaceComments: false

# Templates: template<T> not template <T>; body always on next line
SpaceAfterTemplateKeyword: false
AlwaysBreakTemplateDeclarations: Yes

# Parens: space before ( only for control-flow keywords (if/for/while/switch/do/catch)
SpaceBeforeParens: ControlStatements

# Pointers/refs attach to type: T* p, T& r, T&& rv
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# Braces on same line as declaration
BreakBeforeBraces: Attach

# When params don't fit on one line: each on its own line with ContinuationIndentWidth
# (DontAlign = fixed indent, not aligned to opening paren)
AlignAfterOpenBracket: DontAlign
BinPackArguments: false
BinPackParameters: false

# Constructor initializer list: comma-first, double-indented
#   Foo(int a, int b)
#           : m_a(a)
#           , m_b(b)
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 8

# Short functions: only empty bodies ({}) on one line; lambdas only inline in calls
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never

# Ternary operator: ? and : at start of continuation lines
BreakBeforeTernaryOperators: true

# Binary operators stay at end of line
BreakBeforeBinaryOperators: None

# Braced init lists: allow spaces inside { } (project style: ElementInfo{ a, b, c })
Cpp11BracedListStyle: false

# Empty line before access modifiers when context changes (public → private)
EmptyLineBeforeAccessModifier: LogicalBlock

# Trailing comments: don't align (avoids rewriting comment columns on every edit)
AlignTrailingComments: false

# Include sorting — regroup into priority tiers matching Python Rules.py ordering
# NOTE: clang-format always places the "main" header (matching the .cpp stem) first
# in its own group, separated by a blank line from the rest. This is a minor deviation
# from the project style which has no blank line after the main header.
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  # Relative (sibling) headers — no directory prefix, e.g. "CompareChains.h"
  - Regex:    '"[^/]+'
    Priority: 5
  # Project headers rooted at src/
  - Regex:    '"src/'
    Priority: 10
  # Project headers using catapult/symbol namespace prefix (no src/ root)
  - Regex:    '"(catapult|symbol)/'
    Priority: 11
  # Plugin / extension subtrees
  - Regex:    '"(plugins|extensions)/'
    Priority: 12
  # Test helpers
  - Regex:    '"(tests|test)/'
    Priority: 13
  # External crypto C headers (ref10, openssl, donna)
  - Regex:    '<(ref10|openssl|donna)/'
    Priority: 20
  # Heavy C++ libraries (boost, mongo, rocksdb, benchmark)
  - Regex:    '<(boost|mongocxx|bsoncxx|rocksdb|benchmark)/'
    Priority: 21
  # C++ standard library and OS headers — last, matching project convention
  # (e.g. ChainSynchronizer.cpp: #include <queue> comes after all project includes)
  - Regex:    '<.*>'
    Priority: 30

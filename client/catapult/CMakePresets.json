					}
				]
			},
			"configuration": "Debug"
		},
		{
			"name": "win-RelWithDebInfo",
			"configurePreset": "win-RelWithDebInfo",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "win-Release",
			"configurePreset": "win-Release",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"configuration": "Release"
		},
		{
			"name": "win-MinSizeRel",
			"configurePreset": "win-MinSizeRel",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",

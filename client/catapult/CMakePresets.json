{
	"version": 4,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "vs-base",
			"description": "Base preset for Visual Studio toolset",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/build/install/${presetName}",
			"hidden": true,
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"generator": "Ninja",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"VCPKG_FEATURE_FLAGS": "manifests",
				"VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-ports"
			}
		},
		{
			"name": "win-Debug",
			"displayName": "Windows (VS) configuration Debug",
			"inherits": "vs-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "win-RelWithDebInfo",
			"displayName": "Windows (VS) configuration RelWithDebInfo",
			"inherits": "vs-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"VCPKG_BUILD_TYPE": "release"
			},
			"warnings": {
				"dev": false
			}
		},
		{
			"name": "win-Release",
			"displayName": "Windows (VS) configuration Release",
			"inherits": "vs-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VCPKG_BUILD_TYPE": "release"
			},
			"warnings": {
				"dev": false
			}
		},
		{
			"name": "win-MinSizeRel",
			"displayName": "Windows (VS) configuration MinSizeRel",
			"inherits": "vs-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "MinSizeRel",
				"VCPKG_BUILD_TYPE": "release"
			},
			"warnings": {
				"dev": false
			}
		}
	],
	"buildPresets": [
		{
			"name": "win-Debug",
			"configurePreset": "win-Debug",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"configuration": "Debug"
		},
		{
			"name": "win-RelWithDebInfo",
			"configurePreset": "win-RelWithDebInfo",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "win-Release",
			"configurePreset": "win-Release",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"configuration": "Release"
		},
		{
			"name": "win-MinSizeRel",
			"configurePreset": "win-MinSizeRel",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",

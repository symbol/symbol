{
	"version": 4,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "build-base",
			"description": "This is the base preset for building the project",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/build/install/${presetName}",
			"hidden": true,
			"generator": "Ninja",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"VCPKG_FEATURE_FLAGS": "manifests",
				"VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-ports"
			},
			"warnings": {
				"dev": false
			}
		},
		{
			"name": "win-base",
			"inherits": "build-base",
			"description": "Base preset for Windows (Visual Studio Toolset)",
			"hidden": true,
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "equals",
						"lhs": "$env{VSCMD_ARG_TGT_ARCH}",
						"rhs": "x64"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			}
		},
		{
			"name": "win-Debug",
			"displayName": "Build Catapult in Debug mode",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			},
			"warnings": {
				"dev": true
			}
		},
		{
			"name": "win-RelWithDebInfo",
			"displayName": "Build Catapult in Release mode with limited Debug Info",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"VCPKG_BUILD_TYPE": "release"
			}
		},
		{
			"name": "win-Release",
			"displayName": "Build Catapult in Release mode",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VCPKG_BUILD_TYPE": "release"
			}
		},
		{
			"name": "win-MinSizeRel",
			"displayName": "Build Catapult in MinSizeRel mode (minimal binary sizes)",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "MinSizeRel",
				"VCPKG_BUILD_TYPE": "release"
			}
		},
		{
			"name": "linux-base",
			"inherits": "build-base",
			"description": "Base preset for Linux (GCC/Clang Toolset)",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Linux"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			}
		},
		{
			"name": "linux-Debug",
			"displayName": "Build Catapult in Debug mode",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			},
			"warnings": {
				"dev": true
			}
		},
		{
			"name": "linux-RelWithDebInfo",
			"displayName": "Build Catapult in Release mode with limited Debug Info",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"VCPKG_BUILD_TYPE": "release"
			}
		},
		{
			"name": "linux-Release",
			"displayName": "Build Catapult in Release mode",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VCPKG_BUILD_TYPE": "release"
			}
		},
		{
			"name": "linux-MinSizeRel",
			"displayName": "Build Catapult in MinSizeRel mode (minimal binary sizes)",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "MinSizeRel",
				"VCPKG_BUILD_TYPE": "release"
			}
		}
	],
	"buildPresets": [
		{
			"name": "win-Base",
			"hidden": true,
			"description": "Base build preset for Windows (Visual Studio Toolset)",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"jobs": 4
		},
		{
			"name": "win-Debug",
			"inherits": "win-Base",
			"configurePreset": "win-Debug",
			"configuration": "Debug",
			"displayName": "Build Catapult in Debug mode"
		},
		{
			"name": "win-RelWithDebInfo",
			"inherits": "win-Base",
			"configurePreset": "win-RelWithDebInfo",
			"configuration": "RelWithDebInfo",
			"displayName": "Build Catapult in Release mode with limited Debug Info"
		},
		{

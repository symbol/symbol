			"inherits": "win-Base",
			"configurePreset": "win-Release",
			"configuration": "Release",
			"displayName": "Build Catapult in Release mode"
		},
		{
			"name": "win-MinSizeRel",
			"inherits": "win-Base",
			"configurePreset": "win-MinSizeRel",
			"configuration": "MinSizeRel",
			"displayName": "Build Catapult in MinSizeRel mode (minimal binary sizes)"
		},
		{
			"name": "linux-Base",
			"hidden": true,
			"description": "Base build preset for Linux (GCC/Clang Toolset)",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Linux"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			},
			"jobs": 4
		},
		{
			"name": "linux-Debug",
			"inherits": "linux-Base",
			"configurePreset": "linux-Debug",
			"configuration": "Debug",
			"displayName": "Build Catapult in Debug mode"
		},
		{
			"name": "linux-RelWithDebInfo",
			"inherits": "linux-Base",
			"configurePreset": "linux-RelWithDebInfo",
			"configuration": "RelWithDebInfo",
			"displayName": "Build Catapult in Release mode with limited Debug Info"
		},
		{
			"name": "linux-Release",
			"inherits": "linux-Base",
			"configurePreset": "linux-Release",
			"configuration": "Release",
			"displayName": "Build Catapult in Release mode"
		},
		{
			"name": "linux-MinSizeRel",
			"inherits": "linux-Base",
			"configurePreset": "linux-MinSizeRel",
			"configuration": "MinSizeRel",
			"displayName": "Build Catapult in MinSizeRel mode (minimal binary sizes)"
		}
	],
	"testPresets": [
		{
			"name": "win-Base",
			"hidden": true,
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Windows"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			}
		},
		{
			"name": "win-Debug",
			"inherits": "win-Base",
			"configurePreset": "win-Debug",
			"configuration": "Debug"
		},
		{
			"name": "win-RelWithDebInfo",
			"inherits": "win-Base",
			"configurePreset": "win-RelWithDebInfo",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "win-Release",
			"inherits": "win-Base",
			"configurePreset": "win-Release",
			"configuration": "Release"
		},
		{
			"name": "win-MinSizeRel",
			"inherits": "win-Base",
			"configurePreset": "win-MinSizeRel",
			"configuration": "MinSizeRel"
		},
		{
			"name": "linux-Base",
			"hidden": true,
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "equals",
						"lhs": "${hostSystemName}",
						"rhs": "Linux"
					},
					{
						"type": "notEquals",
						"lhs": "$env{VCPKG_ROOT}",
						"rhs": ""
					}
				]
			}
		},
		{
			"name": "linux-Debug",
			"inherits": "linux-Base",
			"configurePreset": "linux-Debug",
			"configuration": "Debug"
		},
		{
			"name": "linux-RelWithDebInfo",
			"inherits": "linux-Base",
			"configurePreset": "linux-RelWithDebInfo",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "linux-Release",
			"inherits": "linux-Base",
			"configurePreset": "linux-Release",
			"configuration": "Release"
		},
		{
			"name": "linux-MinSizeRel",
			"inherits": "linux-Base",
			"configurePreset": "linux-MinSizeRel",
			"configuration": "MinSizeRel"
		}
	]
}

{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base-vcpkg",
			"description": "Cross platform base preset for vcpkg",
			"hidden": true,
			"generator": "Ninja",
			"condition": {
				"type": "notEquals",
				"lhs": "$env{VCPKG_ROOT}",
				"rhs": ""
			},
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/build/install/${presetName}",
			"cacheVariables": {
				"VCPKG_FEATURE_FLAGS": "manifests",
				"VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-ports"
			},
			"warnings": {
				"dev": false,
				"deprecated": false,
				"unusedCli": false
			}
		},
		{
			"name": "Debug",
			"displayName": "x64 Debug",
			"inherits": "base-vcpkg",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_MESSAGE_LOG_LEVEL": "TRACE"
			},
			"warnings": {
				"dev": true,
				"deprecated": true,
				"unusedCli": true
			}
		},
		{
			"name": "Release",
			"displayName": "x64 Release",
			"inherits": "base-vcpkg",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "RelWithDebInfo",
			"displayName": "x64 RelWithDebInfo",
			"inherits": "base-vcpkg",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "MinSizeRel",
			"displayName": "x64 MinSizeRel",
			"inherits": "base-vcpkg",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "MinSizeRel"
			}
		}
	],
	"buildPresets": [
		{
			"name": "base-build",
			"hidden": true,
			"description": "Base build preset",
			"jobs": 4,
			"cleanFirst": false
		},
		{
			"name": "Debug",
			"inherits": "base-build",
			"configurePreset": "Debug",
			"configuration": "Debug",
			"displayName": "x64 Debug"
		},
		{
			"name": "Release",
			"inherits": "base-build",
			"configurePreset": "Release",
			"configuration": "Release",
			"displayName": "x64 Release"
		},
		{
			"name": "RelWithDebInfo",
			"inherits": "base-build",
			"configurePreset": "RelWithDebInfo",
			"configuration": "RelWithDebInfo",
			"displayName": "x64 RelWithDebInfo"
		},
		{
			"name": "MinSizeRel",
			"inherits": "base-build",
			"configurePreset": "MinSizeRel",
			"configuration": "MinSizeRel",
			"displayName": "x64 MinSizeRel"
		}
	],
	"workflowPresets": [
		{
			"name": "Debug",
			"displayName": "Full Debug Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "Debug"
				},
				{
					"type": "build",
					"name": "Debug"
				}
			]
		},
		{
			"name": "Release",
			"displayName": "Full Release Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "Release"
				},
				{
					"type": "build",
					"name": "Release"
				}
			]
		},
		{
			"name": "RelWithDebInfo",
			"displayName": "Full RelWithDebInfo Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "RelWithDebInfo"
				},
				{
					"type": "build",
					"name": "RelWithDebInfo"
				}
			]
		},
		{
			"name": "MinSizeRel",
			"displayName": "Full MinSizeRel Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "MinSizeRel"
				},
				{
					"type": "build",
					"name": "MinSizeRel"
				}
			]
		}
	]
}
